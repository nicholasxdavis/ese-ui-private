{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "el-sombrero-express",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": [
      "0 16 * * *",
      "0 17 * * *"
    ]
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/public/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "0df6e94205c146ad84a2448345417efa"
    }
  ],
  "observability": {
    "enabled": true
  }
}
